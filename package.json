{
  "name": "@orkestia/lumen-pulse",
  "version": "0.4.0",
  "description": "Framework-agnostic Lumen Pulse client: consent-gated product analytics, error capture and masked session replay for any web UI.",
  "type": "module",
  "license": "MIT",
  "author": "Orkestia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orkestia/lumen-pulse.git"
  },
  "bugs": {
    "url": "https://github.com/orkestia/lumen-pulse/issues"
  },
  "homepage": "https://github.com/orkestia/lumen-pulse#readme",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "import": "./dist/auto.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "./dist/auto.js"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "lumen",
    "pulse",
    "analytics",
    "product-analytics",
    "orkestia",
    "sdk"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "tsup": "^9.0.0",
    "typescript": "^5.8.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "rrweb": "2.1.7"
  }
}
